{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080,
      "autoPort": true,
      "env": {
        "VITE_CACHE_DIR": ".vite-cache"
      }
    },
    {
      "name": "pages-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--base",
        "/egor.website/",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
